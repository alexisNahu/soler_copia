---
import { Image } from "astro:assets";
---

<header>
  <nav
    class="relative flex flex-row container mx-auto justify-between text-secundario px-4 pt-2 z-10"
  >
    <a href="/">
      <Image
        src={"/solerLogo.webp"}
        width={300}
        height={86.69}
        alt="Logo de soler E.A.S."
        class="flex-1 h-auto"
        loading={"eager"}
      />
    </a>

    <ul
      data-navBar="navFlex"
      class="hidden lg:flex flex-row justify-evenly items-center gap-8 font-semibold xl:text-lg transition-colors"
    >
      <li><a href="/">INICIO</a></li>
      <li><a href="/about">QUIÉNES SOMOS</a></li>
      <li><a href="/servicios">SERVICIOS</a></li>
      <li><a href="/profesionales">PROFESIONALES</a></li>
      <li><a href="/contacto">CONTACTO</a></li>
    </ul>
  </nav>
</header>

<script>
  import gsap from "gsap";

  document.addEventListener("DOMContentLoaded", () => {
    const path = window.location.pathname;
    const nav = document.getElementById("menu");

    const navLinks = document.querySelectorAll("nav ul li a");

    navLinks.forEach((link) => {
      if (link.getAttribute("href") === path) {
        link.classList.add("text-primarioOscuro");
      } else {
        link.classList.remove("text-primarioOscuro");
      }
    });

    gsap.to(".row", {});
  });
</script>
