---
import { Image } from "astro:assets";
---

<header>
  <nav
    class="relative flex flex-row container mx-auto justify-between text-secundario px-6 pt-2 z-10 pb-6"
  >
    <a href="/">
      <Image
        src={"/solerLogo.webp"}
        width={300}
        height={86.69}
        alt="Logo de soler E.A.S."
        class="h-auto [mask-image:_radial-gradient(black_60%,_transparent);]"
        loading={"eager"}
      />
    </a>

    <ul
      data-tranisiton="links"
      class="hidden lg:flex flex-row justify-evenly items-center gap-8 font-semibold xl:text-lg transition-colors [&_>_:hover]:text-primario [&_>]:transition-all"
    >
      <li><a href="/">INICIO</a></li>
      <li><a href="/noticias">NOTICIAS</a></li>
      <li><a href="/about">QUIÉNES SOMOS</a></li>
      <li><a href="/servicios">SERVICIOS</a></li>
      <li><a href="/profesionales">PROFESIONALES</a></li>
      <li><a href="/contacto">CONTACTO</a></li>
    </ul>

    <div
      id="nav"
      class="lg:hidden cursor-pointer rounded-full grid place-items-center relative z-50"
    >
      <div class="w-10 h-6 relative">
        <span id="line1" class="w-full h-1 bg-black absolute top-0 rounded-sm"
        ></span>
        <span
          id="line2"
          class="w-full h-1 bg-primarioOscuro absolute top-1/2 transform -translate-y-1/2 rounded-sm"
        ></span>
        <span
          id="line3"
          class="w-full h-1 bg-black absolute bottom-0 rounded-sm"></span>
      </div>
    </div>

    <div
      style="opacity: 0"
      class="nav-screen pointer-events-none lg:hidden h-screen grid place-items-center bg-white fixed inset-0 z-40"
    >
      <ul
        class="nav-items flex flex-col justify-evenly items-center gap-6 font-semibold text-lg"
      >
        <li style="opacity: 0;" class="pointer-events-none">
          <a href="/">INICIO</a>
        </li>
        <li style="opacity: 0;" class="pointer-events-none">
          <a href="/about">QUIÉNES SOMOS</a>
        </li>
        <li style="opacity: 0; " class="pointer-events-none">
          <a href="/servicios">SERVICIOS</a>
        </li>
        <li style="opacity: 0; " class="pointer-events-none">
          <a href="/profesionales">PROFESIONALES</a>
        </li>
        <li style="opacity: 0; " class="pointer-events-none">
          <a href="/contacto">CONTACTO</a>
        </li>
      </ul>
    </div>
  </nav>
</header>

<style></style>

<script>
  import gsap from "gsap";

  document.addEventListener("DOMContentLoaded", () => {
    const sol = document.querySelector("#nav") as HTMLDivElement | null;
    const navLinks = document.querySelectorAll("nav ul li a");
    const navBars = document.querySelectorAll("#nav div span");
    const solNav = document.querySelectorAll("#nav span");
    const anim = document.querySelector('[data-animation="soler"]');
    const navScreen = document.querySelector(
      ".nav-screen"
    ) as HTMLDivElement | null;
    const links = document.querySelectorAll('[data-tranisiton="links"] li a');

    links.forEach((link) => {
      const anchor = link as HTMLAnchorElement;

      anchor.addEventListener("click", (e) => {
        e.preventDefault();
        const href = anchor.href;

        gsap.to(anim, {
          opacity: 0,
          duration: 0.4,
          onComplete: () => {
            window.location.href = href;
          },
        });
      });
    });

    gsap.fromTo(
      '[data-animation="soler"]',
      {
        opacity: 0,
      },
      {
        opacity: 1,
        duration: 1,
      }
    );

    const path = window.location.pathname;

    let isNavScreenVisible = false;

    function NavActive() {
      if (isNavScreenVisible) {
        gsap.to(navBars[0], {
          top: "0",
          rotate: "0",
          duration: 0.5,
          ease: "circ.inOut",
        });
        gsap.to(navBars[1], {
          rotate: "0",
          duration: 0.5,
          ease: "circ.inOut",
        });
        gsap.to(navBars[2], {
          opacity: 1,
          duration: 0.5,
          ease: "circ.inOut",
        });
      } else {
        gsap.to(navBars[0], {
          top: "50%",
          rotate: "45deg",
          duration: 0.5,
          ease: "circ.inOut",
        });
        gsap.to(navBars[1], {
          rotate: "-45deg",
          duration: 0.5,
          ease: "circ.inOut",
        });
        gsap.to(navBars[2], {
          opacity: 0,
          duration: 0.5,
          ease: "circ.inOut",
        });
      }

      if (isNavScreenVisible) {
        document.body.style.overflow = "";

        const navItems = document.querySelectorAll(".nav-items li");
        gsap.fromTo(
          navItems,
          {
            opacity: 1,
            pointerEvents: "auto",
          },
          {
            opacity: 0,
            pointerEvents: "none",
            y: 20,
            stagger: 0.1,
            duration: 0.4,
            ease: "circ.inOut",
            onComplete: () => {
              gsap.to(navScreen, {
                opacity: 0,
                pointerEvents: "none",
                duration: 1,
                ease: "power1.out",
              });
            },
          }
        );
      } else {
        document.body.style.overflow = "hidden";
        gsap.to(navScreen, {
          opacity: 1,
          duration: 0.5,
          ease: "circ.inOut",
          onComplete: () => {
            const navItems = document.querySelectorAll(".nav-items li");
            gsap.fromTo(
              navItems,
              {
                pointerEvents: "none",
                opacity: 0,
                y: 20,
              },
              {
                opacity: 1,
                pointerEvents: "auto",
                y: 0,
                stagger: 0.1,
                duration: 0.3,
                ease: "circ.inOut",
              }
            );
          },
        });
      }

      isNavScreenVisible = !isNavScreenVisible;
    }

    sol?.addEventListener("click", NavActive);

    navLinks.forEach((link) => {
      if (link.getAttribute("href") === path) {
        link.classList.add("text-primarioOscuro");
      } else {
        link.classList.remove("text-primarioOscuro");
      }
    });
  });
</script>
