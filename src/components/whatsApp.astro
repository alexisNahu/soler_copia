---
import { Image } from "astro:assets";
---

<aside class="fixed bottom-6 right-6 z-40">
  <a
    href="https://wa.me/595981115623"
    target="_blank"
    rel="noopener noreferrer"
  >
    <Image
      style="opacity: 0; scale: 0"
      src={"/wa.png"}
      id="whatsapp"
      width={100}
      height={100}
      loading={"eager"}
      alt="Boton de whatsapp"
      class="size-16 lg:size-24"
    /></a
  >
</aside>
<script>
  import gsap from "gsap";

  function Opacity() {
    const wa = document.getElementById("whatsapp");

    gsap.to(wa, {
      opacity: 1,
      delay: 2.5,
      scale: 1,
      duration: 0.3,
    });
  }

  document.addEventListener("DOMContentLoaded", Opacity);
</script>
