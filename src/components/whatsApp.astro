---
import { Image } from "astro:assets";
---

<aside class="fixed bottom-6 right-6">
  <Image
    style="opacity: 0; scale: 0"
    src={"/wa.png"}
    id="whatsapp"
    width={100}
    height={100}
    alt="Boton de whatsapp"
  />
</aside>
<script>
  import gsap from "gsap";

  function Opacity() {
    const wa = document.getElementById("whatsapp");

    gsap.to(wa, {
      opacity: 1,
      delay: 2.5,
      scale: 1,
      duration: 0.3,
    });
  }

  document.addEventListener("DOMContentLoaded", Opacity);
</script>
