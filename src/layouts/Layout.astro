---
import NavBar from "../components/navBar/NavBar.astro";
import Footer from "../components/footer/Footer.astro";
import WhatsApp from "../components/whatsApp.astro";
import "@fontsource-variable/inter";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es-PY">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="En Soler EAS, contamos con un equipo de profesionales altamente cualificados y comprometidos que abarcan una amplia gama de disciplinas."
    />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/solerfavicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content="Soler EAS" />
    <meta
      property="og:description"
      content="En Soler EAS, contamos con un equipo de profesionales altamente cualificados y comprometidos que abarcan una amplia gama de disciplinas."
    />
    <meta property="og:image" content="/solerLogo.webp" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="/solerLogo.webp" />
    <meta name="twitter:title" content="Soler EAS" />
    <meta
      name="twitter:description"
      content="En Soler EAS, contamos con un equipo de profesionales altamente cualificados y comprometidos que abarcan una amplia gama de disciplinas."
    />
    <meta name="twitter:image" content="/sol" />
    <meta name="author" content="Fincreativo" />
    <meta
      name="keywords"
      content="soler, soler eas, equipo, profesionales, disciplinas, multiples disciplinas, consultoria, consultoria especializada, asistencia, asistencia tecnica, asistencia tecnica legal, gestion integral, asesoramiento, buenas practicas"
    />

    <title>{title}</title>
  </head>
  <body class="overflow-x-clip antialiased">
    <NavBar />
    <div style="opacity: 0;" data-animation="soler">
      <slot />
    </div>
    <Footer />
    <WhatsApp />
  </body>

  <style is:global>
    @font-face {
      font-family: "helvetica";
      src: url("../../public/fonts/HelveticaNeueRoman.otf") format("otf");
    }

    body {
      font-family: "helvetica", sans-serif;
    }
  </style>
</html>
