---
import NavBar from "../components/navBar/NavBar.astro";
import Footer from "../components/footer/Footer.astro";
import WhatsApp from "../components/whatsApp.astro";
import "@fontsource-variable/inter";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es-PY">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Astro description" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/solerfavicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="overflow-x-clip antialiased">
    <NavBar />
    <div style="opacity: 0;" data-animation="soler">
      <slot />
    </div>
    <Footer />
    <WhatsApp />
  </body>

  <style is:global>
    @font-face {
      font-family: "helvetica";
      src: url("../../public/fonts/HelveticaNeueRoman.otf") format("otf");
    }

    body {
      font-family: "helvetica", sans-serif;
    }
  </style>
</html>
