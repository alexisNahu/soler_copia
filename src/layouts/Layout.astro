---
import NavBar from "../components/navBar/NavBar.astro";
import Footer from "../components/footer/Footer.astro";
import WhatsApp from "../components/whatsApp.astro";
import "@fontsource-variable/inter";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es-PY">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Consultoría y Asesoramiento. Regencias. Gestión de Habilitaciones y Registros Sanitarios para comercializar e industrializar productos del sector quimico y de producción en general."
    />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/solerfavicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content="Soler EAS" />
    <meta
      property="og:description"
      content="Consultoría y Asesoramiento. Regencias. Gestión de Habilitaciones y Registros Sanitarios para comercializar e industrializar productos del sector quimico y de producción en general."
    />
    <meta property="og:image" content="/solerLogo.webp" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="/solerLogo.webp" />
    <meta name="twitter:title" content="Soler EAS" />
    <meta
      name="twitter:description"
      content="Consultoría y Asesoramiento. Regencias. Gestión de Habilitaciones y Registros Sanitarios para comercializar e industrializar productos del sector quimico y de producción en general."
    />
    <meta name="twitter:image" content="/sol.png" />
    <meta name="author" content="Fincreativo" />
    <meta
      name="keywords"
      content="soler, soler eas, equipo, profesionales, disciplinas, multiples disciplinas, consultoria, consultoria especializada, asistencia, asistencia tecnica, asistencia tecnica legal, gestion integral, asesoramiento, buenas practicas"
    />

    <title>{title}</title>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-02XFE3VBQT"
    ></script>
    <script>
      declare global {
        interface Window {
          dataLayer: any[];
        }
      }
      window.dataLayer = window.dataLayer || [];
      function gtag(...args: any[]) {
        window.dataLayer.push(args);
      }
      gtag("js", new Date());

      gtag("config", "G-02XFE3VBQT");
    </script>
  </head>
  <body class="overflow-x-clip antialiased">
    <NavBar />
    <div style="opacity: 0;" data-animation="soler">
      <slot />
    </div>
    <Footer />
    <WhatsApp />
  </body>

  <style is:global>
    @font-face {
      font-family: "helvetica";
      src: url("../../public/fonts/HelveticaNeueRoman.otf") format("otf");
    }

    body {
      font-family: "helvetica", sans-serif;
    }

    ::-webkit-scrollbar {
      width: 10px;
    }

    ::-webkit-scrollbar-thumb {
      background-color: #5e7482;
      border-radius: 10px;
      cursor: grab;
    }

    ::-webkit-scrollbar-thumb:active {
      cursor: grabbing;
    }
  </style>
</html>
