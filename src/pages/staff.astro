---
import Layout from "@/layouts/Layout.astro";
import { Image } from "astro:assets";
import staff_bg from '../../public/collaborators/staff_bg.png'
import { CollaboratorsServices } from "@/features/collaborators/services";
import type { Collaborators } from "@/features/collaborators/models";

const response = await CollaboratorsServices.get();
const colaboradores: Collaborators[] = response.data;
---

<Layout title="Staff - Soler EAS">
    <section class="relative h-[600px] flex items-start justify-start overflow-hidden pt-48 pl-10 md:pl-32 lg:pl-48">
        <Image
                src={staff_bg}
                alt="Staff Background"
                width={1920}
                height={600}
                loading="eager"
                class="absolute inset-0 w-full h-full object-cover"
        />

        <div class="absolute inset-0 bg-gradient-to-b from-zinc-800/80 from-20% to-transparent pointer-events-none"></div>
        <div class="relative z-10">
            <h1 class="text-white text-7xl md:text-9xl font-extrabold opacity-10 absolute -top-8 -left-4 md:-top-16 md:-left-12 tracking-[0.2em] pointer-events-none select-none">
                STAFF
            </h1>
            <h2 class="text-white text-4xl md:text-5xl font-bold tracking-widest relative">
                STAFF
            </h2>
        </div>
    </section>

    <section class="max-w-7xl mx-auto px-6 py-24">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12">
            {colaboradores.map((persona) => (
                    <article class="bg-white rounded-xl shadow-[0_20px_50px_rgba(0,0,0,0.1)] overflow-hidden border border-slate-100 flex flex-col transition-all hover:-translate-y-3 duration-500">
                        <div class="h-80 overflow-hidden">
                            <img src={persona.image} alt={persona.name} class="w-full h-full object-cover object-top transition-transform duration-700 hover:scale-110" />
                        </div>
                        <div class="p-8 flex flex-col flex-1">
                            <h3 class="text-doradoSoler font-bold text-xl lg:text-2xl mb-1">{persona.name}</h3>
                            <p class="text-slate-400 text-[13px] font-semibold mb-4 uppercase tracking-[0.15em]">{persona.position}</p>
                            <div class="w-12 h-[2px] bg-doradoSoler/30 mb-6"></div>
                            <p class="text-slate-500 text-[15px] leading-relaxed text-justify mb-10 flex-1 italic font-light">
                                "Químico Farmacéutico especializado en asuntos regulatorios, con experiencia en registros sanitarios, cumplimiento normativo y gestión de dossiers."
                            </p>
                            <div class="flex gap-5 items-center pt-5 border-t border-slate-100">
                                <a href={`mailto:${persona.email}`} class="text-slate-400 hover:text-doradoSoler transition-colors">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                                </a>

                                <a href={`https://wa.me/${persona.phone}`} class="text-slate-400 hover:text-doradoSoler transition-colors">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                                </a>

                                <a href="#" class="text-slate-400 hover:text-doradoSoler transition-colors">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                                </a>

                                <a href="#" class="text-slate-400 hover:text-doradoSoler transition-colors">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
                                </a>

                                <a href="#" class="text-slate-400 hover:text-doradoSoler transition-colors">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
                                </a>
                            </div>
                        </div>
                    </article>
            ))}
        </div>
    </section>
</Layout>
