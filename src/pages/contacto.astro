---
import { Image } from "astro:assets";
import HeaderBanner from "../components/headerBanner.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contacto">
  <main>
    <HeaderBanner
      image="/contacto/contactoBanner.webp"
      title="Escribinos"
      title2="CONTACTO"
    />
    <section class="h-full max-lg:pb-12 lg:h-[1070px] relative">
      <Image
        src={"/contacto/contactoBg.webp"}
        width={1920}
        height={624}
        loading={"eager"}
        alt={"Background seccion contacto"}
        class="absolute inset-0 mx-auto h-full object-cover -z-10"
      />
      <div
        class="grid place-items-center lg:grid-cols-2 gap-12 lg:gap-24 pt-12 pb-24 text-lg text-secundario max-w-screen-2xl w-11/12 mx-auto"
      >
        <div class="">
          <p class="mb-6 leading-5">
            Si tiene alguna duda o desea solicitar nuestros servicios complete
            el siguiente formulario de contacto, le responderemos en la brevedad
            posible.
          </p>
          <form id="form" class="flex flex-col">
            <label for="nombre" class="sr-only">Nombre y apellido</label>
            <input
              id="nombre"
              autocomplete="name"
              name="nombre"
              aria-required="true"
              placeholder="Nombre y Apellido *"
              class="bg-transparent border-[1.5px] border-secundario rounded-lg rounded-tr-none px-6 py-4 placeholder:text-secundario placeholder:font-bold focus:outline-none caret-secundario w-full max-w-lg lg:max-w-xl mb-6"
            />
            <label for="phone" class="sr-only">Telefono</label>
            <input
              id="phone"
              autocomplete="tel"
              name="teléfono"
              aria-required="true"
              placeholder="Teléfono"
              class="bg-transparent border-[1.5px] border-secundario rounded-lg rounded-tr-none px-6 py-4 placeholder:text-secundario placeholder:font-bold focus:outline-none caret-secundario w-full max-w-lg lg:max-w-xl mb-6"
            />
            <label for="email" class="sr-only">Correo electrónico</label>
            <input
              id="email"
              autocomplete="name"
              name="email"
              aria-required="true"
              placeholder="Correo electrónico"
              class="bg-transparent border-[1.5px] border-secundario rounded-lg rounded-tr-none px-6 py-4 placeholder:text-secundario placeholder:font-bold focus:outline-none caret-secundario w-full max-w-lg lg:max-w-xl mb-6"
            />

            <textarea
              name="mensaje"
              id="mensaje"
              placeholder="Mensaje"
              rows="4"
              class="bg-transparent border-[1.5px] border-secundario rounded-lg rounded-tr-none px-6 py-4 placeholder:text-secundario placeholder:font-bold focus:outline-none caret-secundario w-full max-w-lg lg:max-w-xl mb-6 resize-none"
            ></textarea>
            <div
              class="g-recaptcha mb-4"
              data-sitekey="6Lf3XK8pAAAAAPBUpr9_8cg0jFbBwoZgUEbe_7Aq"
            >
            </div>
            <button
              type="submit"
              class="text-white px-10 py-3 rounded-lg rounded-tr-none mb-4 bg-primarioOscuro max-w-40"
              >ENVIAR</button
            >
            <div id="alert"></div>
          </form>
        </div>
        <div class="flex flex-col">
          <span>Estamos aquí</span>

          <Image
            src={"/contacto/mapa.webp"}
            width={625}
            height={441}
            alt="Mapa ubicacion"
            class="rounded-lg rounded-tr-none w-full"
          />
        </div>
      </div>
    </section>
  </main>
</Layout>
<script src="https://www.google.com/recaptcha/api.js" async defer></script>
<script>
  const formulario = document.querySelector("#form") as HTMLFormElement | null;
  const alertHTML = document.getElementById("alert") as HTMLDivElement | null;

  formulario?.addEventListener("submit", async (e: Event) => {
    e.preventDefault();

    const datosFormulario = new FormData(formulario);
    const valores: { [key: string]: FormDataEntryValue } = {};

    if (alertHTML) alertHTML.innerHTML = "";

    for (let [key, value] of datosFormulario.entries()) {
      if (
        (key === "nombre" ||
          key === "teléfono" ||
          key === "email" ||
          key === "g-recaptcha-response") &&
        typeof value === "string" &&
        value.trim() === ""
      ) {
        alertHTML?.insertAdjacentHTML(
          "beforeend",
          `<p class="textAlert text-red-400 mx-auto">El campo de ${key === "g-recaptcha-response" ? "Recaptcha" : key} debe ser completado.</p>`
        );
        return;
      }

      valores[key] = value;
    }

    let formValues = { ...valores };

    delete formValues["g-recaptcha-response"];

    console.log(formValues);
  });
</script>
