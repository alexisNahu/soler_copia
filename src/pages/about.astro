---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";

const valores = [
  {
    img: "/about/valores1.svg",
    title: "Excelencia",
    text: "Comprometidos con la calidad y la precisión en nuestros servicios para alcanzar los más altos estándares de cumplimiento regulatorio.",
  },
  {
    img: "/about/valores2.svg",
    title: "Integridad",
    text: "Actuamos con honestidad, transparencia y ética en todas nuestras interacciones con clientes, autoridades y colaboradores.",
  },
  {
    img: "/about/valores3.svg",
    title: "Orientación al cliente",
    text: "Nos enfocamos en comprender las necesidades y expectativas de nuestros clientes para ofrecer soluciones personalizadas y efectivas.",
  },
  {
    img: "/about/valores4.svg",
    title: "Profesionalismo",
    text: "Nos destacamos por nuestro conocimiento especializado, experiencia y dedicación en cada proyecto que emprendemos.",
  },
  {
    img: "/about/valores5.svg",
    title: "Colaboración",
    text: "Trabajamos en equipo, fomentando la colaboración y el intercambio de conocimientos para lograr resultados óptimos.",
  },
  {
    img: "/about/valores6.svg",
    title: "Responsabilidad social y ambiental",
    text: "Nos comprometemos a operar de manera responsable, respetando el medio ambiente y contribuyendo al bienestar de la sociedad.",
  },
];
---

<Layout title="Quiénes somos">
  <main>
    <section
      class="grid grid-cols-1 lg:grid-cols-2 py-12 max-w-screen-2xl w-11/12 mx-auto text-secundario"
    >
      <div
        class="flex flex-col gap-y-6 text-lg lg:text-2xl max-w-xl mx-auto py-12 relative after:absolute after:inset-0 after:content-['LA_EMPRESA'] after:font-bold after:text-5xl xl:after:text-8xl after:text-nowrap after:opacity-15"
      >
        <h1 class="text-3xl lg:text-5xl font-semibold">¿Quiénes somos?</h1>
        <p>
          SOLER E.A.S. es mucho más que una empresa de asesoría regulatoria;
          somos tus aliados estratégicos en el camino hacia el éxito
          empresarial.
        </p>
        <p class="mb-12">
          Con una combinación única de experiencia, conocimiento especializado y
          un enfoque innovador, nos destacamos por ser el puente que conecta tus
          objetivos comerciales con el cumplimiento normativo en el dinámico
          mercado paraguayo.
        </p>
        <div class="flex flex-row max- gap-x-6 lg:gap-x-16 w-full">
          <Image
            src={"/about/about1.svg"}
            height={140}
            width={140}
            widths={[60, 140]}
            sizes={`(max-width:274px) 30px,(max-width: 570px) 60px, (max-width: 720px)139px`}
            alt={"imagen descriptiva flecha y diana"}
            loading={"eager"}
          />
          <Image
            src={"/about/about2.svg"}
            height={140}
            width={140}
            widths={[60, 140]}
            sizes={`(max-width:274px) 30px,(max-width: 570px) 60px, (max-width: 720px)139px`}
            alt={"imagen descriptiva documento y boligrafo"}
            loading={"eager"}
          />

          <Image
            src={"/about/about3.svg"}
            height={147}
            width={139}
            widths={[60, 139]}
            sizes={`(max-width:274px) 30px,(max-width: 570px) 60px, (max-width: 720px)139px`}
            alt={"imagen descriptiva de grafica."}
            loading={"eager"}
          />
        </div>
      </div>
      <div>
        <Image
          src={"/about/aboutHero.webp"}
          width={720}
          height={612}
          alt={"About hero. Dos personas."}
          loading={"eager"}
        />
      </div>
    </section>
    <section class="text-white relative h-[1200px]">
      <Image
        src="/about/aboutBg.webp"
        width={1920}
        height={1300}
        alt="Imagen ilustrativa dos hombres negociacion"
        loading={"eager"}
        class="absolute inset-0 mx-auto -z-10 object-cover h-full [mask-image:_linear-gradient(_transparent,_black_10%);]"
      />
      <div
        class="flex flex-col lg:flex-row gap-x-12 xl:gap-x-24 justify-center w-11/12 mx-auto max-w-screen-2xl"
      >
        <div
          class="py-12 lg:py-24 px-8 lg:px-14 bg-[#d4cdb3] flex flex-col gap-y-6 font-semibold md:text-xl basis-[40%]"
        >
          <h1 class="font-bold text-xl lg:text-3xl">
            Comprometidos con la calidad
          </h1>
          <p>
            En SOLER E.A.S. no solo cumplimos con las expectativas, las
            superamos. Nuestra pasión por la excelencia y la dedicación a la
            satisfacción del cliente nos distinguen en el mercado.
          </p>
          <p>
            Nuestro Equipo de expertos está comprometido con brindarte
            soluciones personalizadas y efectivas que te permitan navegar sin
            contratiempos por el complejo panorama regulatorio. Desde la
            obtención de permisos y registros sanitarios hasta la puesta en
            marcha de plantas industriales, estamos aquí para simplificar cada
            paso del proceso, garantizando la conformidad con las normativas
            vigentes y proporcionándote la tranquilidad que necesitas para
            concentrarte en hacer crecer tu negocio.
          </p>
        </div>
        <div
          class="flex flex-row gap-2 md:gap-6 xl:gap-12 mt-4 lg:mt-24 basis-[50%]"
        >
          <div
            class="bg-[#d4cdb3] py-12 lg:py-24 px-4 md:px-8 lg:px-14 flex flex-col gap-y-6 font-semibold md:text-xl"
          >
            <h2 class="font-bold text-xl lg:text-3xl">Misión</h2>
            <p>
              Brindar servicios de asesoría integral en regulaciones y
              normativas para empresas del sector químico, industrial y de
              producción en Paraguay, garantizando el cumplimiento de requisitos
              legales y sanitarios para la operación segura y exitosa de sus
              negocios.
            </p>
          </div>
          <div
            class="bg-[#d4cdb3] py-12 lg:py-24 px-4 md:px-8 lg:px-14 flex flex-col gap-y-6 font-semibold md:text-xl"
          >
            <h2 class="font-bold text-xl lg:text-3xl">Visión</h2>
            <p>
              Ser reconocidos como líderes en asesoría regulatoria en Paraguay,
              ofreciendo soluciones innovadoras y adaptadas a las necesidades
              específicas de cada cliente, contribuyendo así al desarrollo
              sostenible y al crecimiento de la industria en el país.
            </p>
          </div>
        </div>
      </div>
    </section>
    <section
      class="relative -mt-56 [background:_linear-gradient(transparent,_#d4cdb3_10%);] lg:[background:_linear-gradient(transparent,_#d4cdb3_20%);] text-white"
    >
      <div
        class="flex flex-col gap-y-24 pt-56 pb-32 max-w-screen-2xl w-11/12 mx-auto"
      >
        <h1 class="text-2xl lg:text-4xl font-bold text-center">
          NUESTROS VALORES
        </h1>
        <div
          class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 gap-6 text-sm md:text-base"
        >
          {
            valores.map((value, idx) => {
              return (
                <div data-key={idx} class="flex flex-col">
                  <Image
                    src={value.img}
                    width={140}
                    height={140}
                    alt={value.title}
                    loading={"eager"}
                    class="mx-auto mb-4"
                  />
                  <h2 class="font-bold text-lg xl:text-xl lg:text-2xl h-[80px] text-center">
                    {value.title}
                  </h2>
                  <p>{value.text}</p>
                </div>
              );
            })
          }
        </div>
      </div>
    </section>
  </main>
</Layout>
