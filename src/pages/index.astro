---
import Layout from "../layouts/Layout.astro";

import NuestrosServicios from "@/features/index/NuestrosServicios.astro";
import EquipoProfesional from "@/features/index/EquipoProfesional.astro";
import Noticias from "@/features/index/Noticias.astro";

import Hero from "../features/index/Hero.astro";
---

<Layout title="SOLER EAS">
  <main>
    <Hero />

    <NuestrosServicios />

    <EquipoProfesional />

    <Noticias />
  </main>
</Layout>

<script>
  import gsap from "gsap";

  const animateTextByLetter = (element: HTMLElement, text: string) => {
    element.textContent = "";
    const docFragment = document.createDocumentFragment();

    Array.from(text).forEach((letter) => {
      const span = document.createElement("span");
      span.textContent = letter;
      span.style.opacity = "0";
      docFragment.appendChild(span);
    });

    element.appendChild(docFragment);

    gsap.to(Array.from(element.children), {
      opacity: 1,
      ease: "sine.inOut",
      stagger: 0.015,
      duration: 0.5,
    });
  };

  const script = () => {
    const p1 = document.getElementById("paragraph1");
    const p2 = document.getElementById("paragraph2");

    const texto1 = "En un entorno empresarial cada vez más complejo y regulado...";
    const texto2 = "Contar con el apoyo de una consultora especializada en temas regulatorios se vuelve fundamental para las empresas en Paraguay.";

    if (p1 && p2) {
      animateTextByLetter(p1, texto1);
      const totalDelayForP1 = texto1.length * 0.05 + 0.5;
      setTimeout(() => {
        animateTextByLetter(p2, texto2);
      }, totalDelayForP1 * 400);
    }
  };

  document.addEventListener("DOMContentLoaded", script);
</script>
