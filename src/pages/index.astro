---
import Layout from "../layouts/Layout.astro";
import { Image, Picture } from "astro:assets";

const garanitzamos = [
  {
    img: "/index/garantizamos1.svg",
    title: "ASESORAMIENTO EXPERTO",
  },
  {
    img: "/index/garantizamos2.svg",
    title: "SOLUCIONES PERSONALIZADAS",
  },
  {
    img: "/index/garantizamos3.svg",
    title: "ADAPTADAS A NECESIDADES ESPECIFÍCAS",
  },
  {
    img: "/index/garantizamos4.svg",
    title: "GESTIÓN EFICIENTE",
  },
  {
    img: "/index/garantizamos5.svg",
    title: "PROCESOS SEGUROS",
  },
  {
    img: "/index/garantizamos6.svg",
    title: "REQUERIMIENTOS VIGENTES",
  },
];

const servicios = [
  {
    img: "/index/servicio1.webp",
    title: "CONSULTORÍA ESPECIALIZADA",
  },
  {
    img: "/index/servicio2.webp",
    title: "GESTIÓN INTEGRAL DE REGULACIONES SANITARIAS",
  },
  {
    img: "/index/servicio3.webp",
    title: "ASESORAMIENTO REGULATORIO",
  },
  {
    img: "/index/servicio4.webp",
    title: "IMPLEMENTACIÓN DE BUENAS PRÁCTICAS Y CONTROL DE CALIDAD",
  },
  {
    img: "/index/servicio5.webp",
    title: "ASISTENCIA TÉCNICA, LEGAL Y FINANCIERA",
  },
];
---

<Layout title="SOLER EAS">
  <main>
    <section
      class="relative h-[1200px] lg:h-[1520px] w-full max-w-[1920px] mx-auto"
    >
      <Image
        src={"/index/solerHero.webp"}
        width={1920}
        height={1820}
        alt="Hero index solar E.A.S. imagen descriptiva empresarial"
        loading={"eager"}
        class="mx-auto object-cover absolute inset-0 -z-10 h-full animate-fade -mt-32 [mask-image:_linear-gradient(black_80%,_transparent);]"
      />
      <div class="flex flex-col h-full justify-between pt-24 pb-24">
        <div class="mx-auto text-secundario max-w-7xl px-4 md:px-12">
          <p
            id="paragraph1"
            class="font-bold text-xl md:text-2xl lg:text-3xl text-center mb-12 min-w-[270px]"
          >
          </p>
          <p
            id="paragraph2"
            class="text-center text-xl sm:text-2xl lg:text-3xl font-normal leading-5 min-w-[270px]"
          >
          </p>
        </div>
        <div class="w-full">
          <hgroup class="relative py-16">
            <h1
              class="text-white text-center text-3xl lg:text-5xl relative z-10 max-lg:[text-shadow:_0_1px_0_rgb(0_0_0_/_40%)]"
            >
              COMO EMPRESA GARANTIZAMOS...
            </h1>
            <h1
              class="text-secundario text-3xl lg:text-6xl font-bold xl:text-9xl pointer-events-none select-none absolute max-sm:inset-14 sm:inset-6 text-opacity-20 mx-auto text-center"
            >
              GARANTIZAMOS
            </h1>
          </hgroup>
          <div class="mx-auto">
            <div
              class="bg-[#90A5BA] bg-opacity-90 min-w-[270px] flex flex-wrap justify-center max-lg:mx-auto lg:flex-row gap-2 md:gap-4 p-8"
            >
              {
                garanitzamos.map((value, idx) => (
                  <div
                    data-garatizamos={`Garantia ${idx}`}
                    class="flex flex-col text-white flex-1 items-center mx-auto text-center text-xs sm:text-base lg:text-lg md:font-bold"
                  >
                    <Image
                      src={value.img}
                      width={110}
                      widths={[40, 60, 110]}
                      height={110}
                      alt={value.title}
                      class="mx-auto aspect-square mb-2 max-sm:w-[60px]"
                      sizes={`(max-width:380px) 40px,(max-width: 570px) 60px, (max-width: 720px)110px`}
                      loading={"lazy"}
                    />
                    <span>{value.title}</span>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="pb-24 max-w-screen-2xl w-11/12 mx-auto relative z-10">
      <h1
        class="text-primarioOscuro text-center text-3xl lg:text-5xl font-semibold mb-12"
      >
        NUESTROS SERVICIOS
      </h1>
      <div class="flex justify-center flex-wrap gap-6">
        {
          servicios.map((value, idx) => (
            <div
              data-servicio={`Servicio: ${idx}`}
              class={`flex flex-col rounded-lg rounded-tr-none h-[420px] md:h-[480px] lg:h-[540px] text-white bg-doradoSoler w-56 lg:w-64 min-[1680px]:w-72`}
            >
              <div class="basis-4/12 flex pt-12 text-center  text-sm md:text-base xl:text-xl justify-center p-3 font-bold">
                {value.title}
              </div>
              <div>
                <Image
                  src={value.img}
                  width={600}
                  height={400}
                  alt=""
                  class={`w-full h-auto`}
                  loading={"lazy"}
                />
              </div>
              <div class="p-4 flex items-center justify-center flex-1">
                <button class="px-2 sm:px-4 md:px-6 py-3 text-sm md:text-base border-2 rounded-md rounded-tr-none border-white bg-transparent hover:bg-primarioOscuro transition-colors uppercase">
                  <a
                    href="https://wa.me/595981117986"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {" "}
                    Me interesa
                  </a>
                </button>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="relative h-[1250px] max-w-[1920px] m-auto -mt-48">
      <picture>
        <source media="(min-width:500px)" srcset="/index/NuestroEquipo.webp" />

        <Image
          src={"/index/NuestroEquipoMobile.webp"}
          width={1920}
          height={1500}
          loading={"eager"}
          alt="Nuestro equipo"
          class="absolute object-left inset-0 -z-10 h-[1450px] object-cover w-full [mask-image:_linear-gradient(transparent,_black_5%);]"
        />
      </picture>
      <div
        class="pt-48 max-w-6xl min-w-[270px] px-18 mx-auto text-lg md:text-xl lg:text-3xl font-bold text-center text-white"
      >
        <p>
          EN SOLER EAS, CONTAMOS CON UN EQUIPO DE PROFESIONALES ALTAMENTE
          CALIFICADOS Y COMPROMETIDOS QUE ABARCAN UNA AMPLIA GAMA DE
          DISCIPLINAS.
        </p>
      </div>
      <div
        class="grid place-items-center justify-items-end w-full h-full pb-24"
      >
        <div
          class="bg-secundario/80 px-4 py-8 sm:px-12 sm:py-16 lg:py-28 lg:px-32 text text-white backdrop-blur-sm max-w-5xl"
        >
          <h1 class="mb-6 md:mb-12 font-semibold text-2xl lg:text-4xl">
            Nuestro equipo multidisciplinario está compuesto por:
          </h1>
          <ul class="flex flex-col gap-y-2 text-sm md:text-base lg:text-lg">
            <li class="flex gap-x-2 font-semibold">
              <Image
                src={"/index/check.svg"}
                width={23}
                height={23}
                alt="check"
                loading={"eager"}
              />
              <span>INGENIEROS QUÍMICOS</span>
            </li>
            <li class="flex gap-x-2 font-semibold">
              <Image
                src={"/index/check.svg"}
                width={23}
                height={23}
                alt="check"
                loading={"eager"}
              />
              <span>QUÍMICOS FARMACÉUTICOS</span>
            </li>
            <li class="flex gap-x-2 font-semibold">
              <Image
                src={"/index/check.svg"}
                width={23}
                height={23}
                alt="check"
                loading={"eager"}
              />
              <span>TECNÓLOGOS DE ALIMENTOS VETERINARIOS</span>
            </li>

            <li class="flex gap-x-2 font-semibold">
              <Image
                src={"/index/check.svg"}
                width={23}
                height={23}
                alt="check"
                loading={"eager"}
              />
              <span>INGENIEROS AGRÓNOMOS Y AMBIENTALES</span>
            </li>
            <li class="flex gap-x-2 font-semibold">
              <Image
                src={"/index/check.svg"}
                width={23}
                height={23}
                alt="check"
                loading={"eager"}
              />
              <span>INGENIEROS CIVILES</span>
            </li>
            <li class="flex gap-x-2 font-semibold">
              <Image
                src={"/index/check.svg"}
                width={23}
                height={23}
                alt="check"
                loading={"eager"}
              />
              <span>ARQUITECTOS</span>
            </li>
            <li class="flex gap-x-2 font-semibold">
              <Image
                src={"/index/check.svg"}
                width={23}
                height={23}
                alt="check"
                loading={"eager"}
              />
              <span>ABOGADOS DESPACHANTES DE ADUANAS</span>
            </li>
            <li class="flex gap-x-2 font-semibold">
              <Image
                src={"/index/check.svg"}
                width={23}
                height={23}
                alt="check"
                loading={"eager"}
              />
              <span>PROFESIONALES DE COMERCIO EXTERIOR</span>
            </li>
          </ul>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  import gsap from "gsap";

  const animateTextByLetter = (element: HTMLElement, text: string) => {
    element.textContent = "";

    const docFragment = document.createDocumentFragment();

    Array.from(text).forEach((letter) => {
      const span = (document.createElement("span") as HTMLSpanElement) || null;
      span.textContent = letter;
      span.style.opacity = "0";
      docFragment.appendChild(span);
    });

    element.appendChild(docFragment);

    gsap.to(Array.from(element.children), {
      opacity: 1,
      ease: "sine.inOut",
      stagger: 0.015,
      duration: 0.5,
    });
  };

  const script = () => {
    const p1 = document.getElementById("paragraph1");
    const p2 = document.getElementById("paragraph2");

    const texto1 =
      "En un entorno empresarial cada vez más complejo y regulado...";
    const texto2 =
      "Contar con el apoyo de una consultora especializada en temas regulatorios se vuelve fundamental para las empresas en Paraguay.";

    if (p1 && p2) {
      animateTextByLetter(p1, texto1);

      const totalDelayForP1 = texto1.length * 0.05 + 0.5;

      setTimeout(() => {
        animateTextByLetter(p2, texto2);
      }, totalDelayForP1 * 400);
    }
  };

  document.addEventListener("DOMContentLoaded", script);
</script>
