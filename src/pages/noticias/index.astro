---
import Card from "../../features/noticias/components/card.astro";
import NoticiasLayout from "../../layouts/NoticiasLayout.astro";

import { NewsServices } from "@/features/noticias/services";
import type { News } from "@/features/noticias/models";
import {CategoryServices} from "../../features/category/services";

const response = await NewsServices.get();
const categorias_response = await CategoryServices.get()
const categorias = categorias_response.data
const noticias: News[] = response.data;
console.log(noticias)

---
<NoticiasLayout title="Noticias - Soler EAS">
    <div class="flex flex-col lg:flex-row gap-12">
        <div class="flex-1">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-12">
                {noticias.map((item) => (
                        <Card item={item} href=`noticias/${item.slug}` desde="noticias" />
                ))}
            </div>

            {/* Paginación (puedes hacerla dinámica más adelante con los datos de la API) */}
            <div class="flex justify-center items-center gap-2 mt-16 text-sm font-bold text-slate-400">
                <button class="hover:text-slate-600 transition-colors uppercase tracking-tighter">&lt; Anterior</button>
                <button class="w-8 h-8 flex items-center justify-center bg-doradoSoler text-white rounded-sm">1</button>
                <button class="w-8 h-8 flex items-center justify-center bg-slate-100 hover:bg-slate-200 text-slate-500 rounded-sm transition-colors">2</button>
                <button class="w-8 h-8 flex items-center justify-center bg-slate-100 hover:bg-slate-200 text-slate-500 rounded-sm transition-colors">3</button>
                <button class="hover:text-slate-600 transition-colors uppercase tracking-tighter">Siguiente &gt;</button>
            </div>
        </div>

        <aside class="w-full lg:w-64">
            <div class="bg-doradoSoler text-white px-4 py-2 font-bold uppercase tracking-widest text-sm mb-4 rounded-sm">
                Categorías
            </div>

            <ul class="flex flex-col border-b border-slate-100">
                {categorias.map(cat => (
                        <li class="border-t border-slate-100 py-3 text-[11px] font-bold text-slate-500 hover:text-doradoSoler cursor-pointer transition-colors uppercase tracking-wider">
                            {cat.name}
                        </li>
                ))}
            </ul>
        </aside>
    </div>
</NoticiasLayout>
