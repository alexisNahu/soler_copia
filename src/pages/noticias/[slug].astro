---
export const prerender = true
import NoticiasLayout from "../../layouts/NoticiasLayout.astro";
import {noticias} from "../../constans";

export async function getStaticPaths() {
  return noticias.map((noticia) => ({
    params: { slug: noticia.slug },
    props: { noticia },
  }));
}

const { noticia } = Astro.props;

const otrasNoticias = [
  "Asesoría Integral en Regulaciones y Normativas para empresas del Sector Químico",
  "Paraguay está avanzando hacia una economía cada vez más industrial"
];
---

<NoticiasLayout>
  <a href="/noticias" class="font-bold text-slate-400 hover:text-[#d4b56b] transition-colors flex items-center gap-1 mb-6 uppercase tracking-tight">
    <span class="text-xs">‹</span> Volver a todas las noticias
  </a>

  <div class="flex flex-col lg:flex-row gap-12">
    <article class="flex-1">
      <span class="font-bold text-slate-400">{noticia.fecha}</span>
      <h2 class="text-3xl font-bold text-slate-600 mt-2 mb-4 leading-tight">
        {noticia.titulo}
      </h2>

      <div class="flex gap-2 mb-8">
        {noticia.tags.map(tag => (
            <span class="bg-[#90A5BA] text-white text-[9px] px-2.5 py-1 rounded-sm font-bold uppercase tracking-wider">
                        {tag}
                    </span>
        ))}
      </div>

      <div class="rounded-2xl overflow-hidden shadow-sm mb-8">
        <img src={noticia.img} alt={noticia.titulo} class="w-full h-auto object-cover" />
      </div>

      <div class="space-y-6 text-slate-500 text-sm leading-relaxed text-justify" set:html={noticia.contenido}>
      </div>
    </article>

    <aside class="w-full lg:w-72 shrink-0">
      <div class="bg-[#d4b56b] text-white px-4 py-2 font-bold uppercase tracking-widest text-[16px] mb-4">
        MÁS NOTICIAS
      </div>

      <div class="space-y-4">
        {otrasNoticias.map((titulo) => (
            <div class="group cursor-pointer border-b border-slate-100 pb-4 last:border-0">
              <div class="flex gap-3 items-start">
                <span class="text-[#90A5BA] mt-1.5 shrink-0 text-[8px]">■</span>
                <p class="text-slate-500 group-hover:text-[#d4b56b] transition-colors leading-snug">
                  {titulo}
                </p>
              </div>
            </div>
        ))}
      </div>

      <a href="/noticias" class="inline-block mt-8 bg-[#90A5BA]/40 hover:bg-[#90A5BA]/60 text-white text-[10px] font-bold px-4 py-2 rounded-sm transition-all uppercase tracking-wider">
        Ver todas las noticias
      </a>
    </aside>
  </div>
</NoticiasLayout>
