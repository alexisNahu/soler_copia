---
export const prerender = true
import NoticiasLayout from "../../layouts/NoticiasLayout.astro";
import {noticias} from "../../constans";
import {Image} from "astro:assets";

export async function getStaticPaths() {
  return noticias.map((noticia) => ({
    params: { slug: noticia.slug },
    props: { noticia },
  }));
}

const { noticia } = Astro.props;

const otrasNoticias = [
  "Asesoría Integral en Regulaciones y Normativas para empresas del Sector Químico",
  "Paraguay está avanzando hacia una economía cada vez más industrial"
];
---

<NoticiasLayout>
  <a href="/noticias" class="hover:text-[#d4b56b] transition-colors flex items-center gap-1 mb-6 tracking-tight">
    <span class="text-2xl mx-1">‹</span> Volver a todas las noticias
  </a>

  <div class="flex flex-col lg:flex-row gap-12">
    <article class="flex-1">
      <span>{noticia.fecha}</span>
      <h2 class="text-3xl font-bold text-slate-600 mt-2 mb-4 leading-tight">
        {noticia.titulo}
      </h2>

      <div class="flex gap-2 mb-8">
        {noticia.tags.map(tag => (
            <span class="bg-[#90A5BA] text-white text-[9px] px-2.5 py-1 rounded-sm font-bold uppercase tracking-wider">
                        {tag}
                    </span>
        ))}
      </div>

      <div class="rounded-2xl overflow-hidden shadow-sm mb-8">
        <Image
          src={noticia.img}
          width={800}
          height={200}
          alt={noticia.titulo}
          class="w-full h-auto object-cover"
        />
      </div>

      <div class="space-y-6 text-slate-500 text-sm leading-relaxed text-justify" set:html={noticia.contenido}>
      </div>
    </article>

    <aside class="w-full lg:w-80 shrink-0">
      <div class="bg-doradoSoler text-white px-6 py-3 font-bold uppercase tracking-[0.2em] text-lg mb-8 rounded-lg rounded-tr-none">
        MÁS NOTICIAS
      </div>

      <div class="flex flex-col">
        {otrasNoticias.map((titulo) => (
            <div class="group cursor-pointer border-b border-doradoSoler py-5 transition-all">
              <div class="flex gap-4 items-start">
                {/* La pelotita azul */}
                <span class="w-2.5 h-2.5 bg-secundario mt-1.5 shrink-0 rounded-sm"></span>

                <p class="text-slate-500 group-hover:text-doradoSoler transition-colors leading-snug font-medium text-[15px]">
                  {titulo}
                </p>
              </div>
            </div>
        ))}
      </div>

      <a href="/noticias"
         class="flex items-center justify-center gap-2 mt-10 bg-secundario/40 hover:bg-secundario/60 text-white py-2 rounded-md transition-all uppercase tracking-widest group">
        <span class="text-lg leading-none">›</span>
        Ver todas las noticias
      </a>
    </aside>
  </div>
</NoticiasLayout>
