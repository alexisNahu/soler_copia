---
import { Image } from "astro:assets";

interface Props {
    item: {
        img: string,
        fecha?: string,
        titulo: string,
        tags: string[],
        href: string
    },
    desde: 'index' | 'noticias'
}

const { item, desde } = Astro.props;

const isNoticias = desde === 'noticias';
---

<article class="group cursor-pointer w-full mb-12 last:mb-0">
    <a
            href={item.href}
            class={`flex ${isNoticias ? 'flex-col gap-6' : 'flex-col md:flex-row items-center md:items-start gap-8 md:gap-12'}`}
    >
        {/* 1. Contenedor de Imagen: Cuadrado y muy redondeado como en la foto */}
        <div class={`relative shrink-0 overflow-hidden transition-all duration-500 
        ${isNoticias
            ? 'w-full aspect-[4/3] rounded-2xl'
            : 'w-full md:w-64 h-64 rounded-[40px]' // Redondeado extra para imitar la imagen
        }`}>

            {isNoticias && (
                    <div class="absolute top-0 left-0 bg-doradoSoler text-white px-4 py-2 text-sm font-medium z-10 rounded-br-xl">
                        {item.fecha}
                    </div>
            )}

            <Image
                    src={item.img}
                    alt={item.titulo}
                    width={500}
                    height={500}
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
            />
        </div>

        {/* 2. Contenedor de Información */}
        <div class="flex flex-col gap-2 py-1 max-w-2xl">
            {/* Fecha: Gris azulado sutil */}
            {!isNoticias && (
                    <span class="text-slate-400 text-lg font-medium tracking-tight">
                    {item.fecha}
                </span>
            )}

            {/* Tags: Estilo pastilla sutil */}
            <div class="flex flex-wrap gap-2 mb-1">
                {item.tags.map(tag => (
                        <span class="bg-[#90A5BA]/30 text-[#718096] text-[10px] px-3 py-1 rounded-md font-bold uppercase tracking-wider">
                        {tag}
                    </span>
                ))}
            </div>

            {/* Título: Grande, Slate oscuro y leading estrecho */}
            <h3 class={`font-bold text-[#4A5568] leading-[1.2] transition-colors group-hover:text-doradoSoler
            ${isNoticias ? 'text-xl' : 'text-2xl md:text-3xl lg:text-[32px]'}`}>
                {item.titulo}
            </h3>
        </div>
    </a>
</article>
